{
  "name": "AeroApp — Aircraft Tool Familiarization",
  "short_name": "AeroApp",
  "description": "Learn aircraft maintenance tools with 3D models, narration and quizzes. Works offline.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0d1117",
  "theme_color": "#172554",
  "categories": ["education"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Tools", "url": "/app/tools", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quizzes", "url": "/app/quizzes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
