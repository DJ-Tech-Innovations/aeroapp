{
  "name": "AeroApp Admin",
  "short_name": "AeroApp Admin",
  "description": "Manage AeroApp tools, quizzes, classes and content packs.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0d1117",
  "theme_color": "#172554",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tools", "url": "/admin/tools", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Learner app", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
